{
  "name": "tosca-playwright-migration",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "convert": "python tools/tsu_to_playwright.py",
    "convert:all": "python tools/tsu_to_playwright.py imports/tsu",
    "test": "playwright test",
    "test:generated": "playwright test tests/generated",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
