    "hub": "python tools/hub.py",
    "start": "python tools/hub.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
